// Companies on a project (for dropdowns)
app.get("/projects/:projectId/companies", requireAuth, async (req, res) => {
  try {
    const { projectId } = req.params;

    // must be in project
    const mem = await pool.query(
      `SELECT 1 FROM project_members WHERE project_id=$1 AND user_id=$2`,
      [projectId, req.userId]
    );
    if (!mem.rows[0]) return res.status(403).json({ error: "Not in project" });

    // companies that have at least one member on the project
    const { rows } = await pool.query(
      `SELECT DISTINCT c.id, c.name, c.type
       FROM companies c
       JOIN project_members pm ON pm.company_id = c.id
       WHERE pm.project_id = $1
       ORDER BY c.type, c.name`,
      [projectId]
    );

    res.json(rows);
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Server error" });
  }
});

// ----------------------
// SCHEDULE ROUTES
// ----------------------

// Get schedule items for project
app.get("/schedule/:projectId", requireAuth, async (req, res) => {
  try {
    const { projectId } = req.params;

    const memQ = await pool.query(
      `SELECT role, company_id
       FROM project_members
       WHERE project_id = $1 AND user_id = $2`,
      [projectId, req.userId]
    );

    const mem = memQ.rows[0];
    if (!mem) return res.status(403).json({ error: "Not in project" });

    const isGC = String(mem.role || "").startsWith("GC");

    let result;

    if (isGC) {
      result = await pool.query(
        `SELECT * FROM schedule_items
         WHERE project_id = $1
         ORDER BY start_at ASC`,
        [projectId]
      );
    } else {
      result = await pool.query(
        `SELECT * FROM schedule_items
         WHERE project_id = $1
           AND (assigned_company_id = $2 OR assigned_company_id IS NULL)
         ORDER BY start_at ASC`,
        [projectId, mem.company_id]
      );
    }

    res.json(result.rows);
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Server error" });
  }
});

// Create schedule item (GC only)
app.post("/schedule/:projectId", requireAuth, async (req, res) => {
  try {
    const { projectId } = req.params;
    const { title, location, start_at, end_at, assigned_company_id } = req.body;

    const memQ = await pool.query(
      `SELECT role FROM project_members
       WHERE project_id = $1 AND user_id = $2`,
      [projectId, req.userId]
    );

    const mem = memQ.rows[0];
    if (!mem || !String(mem.role || "").startsWith("GC")) {
      return res.status(403).json({ error: "Only GC can create schedule items" });
    }

    const insert = await pool.query(
      `INSERT INTO schedule_items
       (project_id, title, location, start_at, end_at, assigned_company_id, created_by_user_id)
       VALUES ($1,$2,$3,$4,$5,$6,$7)
       RETURNING *`,
      [projectId, title, location, start_at, end_at, assigned_company_id || null, req.userId]
    );

    res.json(insert.rows[0]);
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Server error" });
  }
});

// ----------------------
// SCHEDULE STATUS ACTIONS
// ----------------------

// Mark schedule item DONE (SUB can only do items assigned to their company)
app.post("/schedule-item/:id/done", requireAuth, async (req, res) => {
  try {
    const { id } = req.params;
    if (!isUuid(id)) return res.status(400).json({ error: "Invalid id" });

    const itemQ = await pool.query(
      `SELECT id, project_id, assigned_company_id, status
       FROM schedule_items
       WHERE id = $1`,
      [id]
    );
    const item = itemQ.rows[0];
    if (!item) return res.status(404).json({ error: "Not found" });

    const memQ = await pool.query(
      `SELECT role, company_id
       FROM project_members
       WHERE project_id = $1 AND user_id = $2`,
      [item.project_id, req.userId]
    );
    const mem = memQ.rows[0];
    if (!mem) return res.status(403).json({ error: "Not in project" });

    const isGC = String(mem.role || "").startsWith("GC");

    // subs can only mark DONE for items assigned to their company
    if (!isGC && item.assigned_company_id !== mem.company_id) {
      return res.status(403).json({ error: "Not your company’s schedule item" });
    }

    if (item.status === "CANCELED") return res.status(400).json({ error: "Item is canceled" });

    const updated = await pool.query(
      `UPDATE schedule_items
       SET status = 'DONE'
       WHERE id = $1
       RETURNING *`,
      [id]
    );

    res.json(updated.rows[0]);
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Server error" });
  }
});

// Verify schedule item (GC only)
app.post("/schedule-item/:id/verify", requireAuth, async (req, res) => {
  try {
    const { id } = req.params;

    const q = await pool.query(
      `SELECT si.id, si.status, si.project_id, pm.role
       FROM schedule_items si
       JOIN project_members pm ON pm.project_id = si.project_id
       WHERE si.id = $1 AND pm.user_id = $2`,
      [id, req.userId]
    );

    const row = q.rows[0];
    if (!row) return res.status(404).json({ error: "Item not found" });

    const role = row.role;
    const isGC = role === "GC_ADMIN" || role === "GC_PM" || role === "GC";
    if (!isGC) return res.status(403).json({ error: "Forbidden" });

    if (row.status === "CANCELED") {
      return res.status(409).json({ error: "Item is canceled" });
    }
    if (row.status !== "DONE") {
      return res.status(409).json({
        error: "Only DONE items can be verified",
        currentStatus: row.status,
      });
    }

    const updated = await pool.query(
      `UPDATE schedule_items
       SET status = 'VERIFIED'
       WHERE id = $1
       RETURNING *`,
      [id]
    );

    res.json(updated.rows[0]);
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Server error" });
  }
});

// Cancel schedule item (GC only)
app.post("/schedule-item/:id/cancel", requireAuth, async (req, res) => {
  try {
    const { id } = req.params;
    if (!isUuid(id)) return res.status(400).json({ error: "Invalid id" });

    const itemQ = await pool.query(
      `SELECT id, project_id
       FROM schedule_items
       WHERE id = $1`,
      [id]
    );
    const item = itemQ.rows[0];
    if (!item) return res.status(404).json({ error: "Not found" });

    const memQ = await pool.query(
      `SELECT role
       FROM project_members
       WHERE project_id = $1 AND user_id = $2`,
      [item.project_id, req.userId]
    );
    const mem = memQ.rows[0];
    if (!mem) return res.status(403).json({ error: "Not in project" });

    if (!String(mem.role || "").startsWith("GC")) {
      return res.status(403).json({ error: "Only GC can cancel schedule items" });
    }

    const updated = await pool.query(
      `UPDATE schedule_items
       SET status = 'CANCELED'
       WHERE id = $1
       RETURNING *`,
      [id]
    );

    res.json(updated.rows[0]);
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Server error" });
  }
});

const port = Number(process.env.PORT || 3000);
app.listen(port, () => console.log(`API running on http://localhost:${port}`));